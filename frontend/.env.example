E2E_BASE_URL=http://localhost:5173
E2E_USERNAME=admin
E2E_PASSWORD=password
PW_SCREENSHOTS=on
PW_OUTPUT_DIR=playwright_temp

# Set to 1 to run `npm run dev` against MSW mocks (see docs/dev-quickstart.md).
# Leave unset / 0 to proxy /api/* to WEBAPI_URL, defaulting to localhost:8080.
VITE_USE_MOCKS=0

# WEBAPI_URL=http://localhost:8080
